{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Proper-Time-Physics-Institute/FerroAstro/tests/vectors/schema.json",
  "title": "FerroAstro test-vector file (ADR-0004, TST-002, TST-003)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vector"],
  "properties": {
    "schema_version": { "const": 1 },
    "vector": { "type": "array", "items": { "$ref": "#/$defs/vector" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "provenance": {
      "type": "string",
      "pattern": "\\S",
      "not": { "anyOf": [ { "pattern": "UNVERIFIED" }, { "pattern": "\\[S\\]" } ] }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "quantity", "value", "unit", "kind", "source", "citation",
                   "retrieved", "tolerance", "tolerance_rationale", "verified_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "requirement": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "pattern": "^(ORG|STD|PHY|NUM|TST|API|AGT|DEP|REF|CI|LIC)-[0-9]{3}$" }
        },
        "quantity": { "$ref": "#/$defs/text" },
        "value": {
          "oneOf": [
            { "type": "integer", "minimum": -9007199254740992, "maximum": 9007199254740992 },
            { "type": "number", "not": { "type": "integer" } },
            { "type": "string", "pattern": "^\\s*[-+]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][-+]?[0-9]+)?\\s*$" }
          ]
        },
        "unit": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["defined", "measured", "computed-reference", "analytic"] },
        "source": { "$ref": "#/$defs/provenance" },
        "citation": { "$ref": "#/$defs/provenance" },
        "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "tolerance": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "abs": { "type": "number", "minimum": 0 },
            "rel": { "type": "number", "minimum": 0 }
          }
        },
        "tolerance_rationale": { "$ref": "#/$defs/text" },
        "verified_by": { "$ref": "#/$defs/text" },
        "generated_by": { "type": "string", "pattern": "^.+@[0-9a-f]{7,40}$" },
        "engine": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "settings"],
          "properties": {
            "name": { "$ref": "#/$defs/text" },
            "version": { "$ref": "#/$defs/text" },
            "settings": { "$ref": "#/$defs/text" }
          }
        },
        "notes": { "type": "string" },
        "blocked_by": { "type": "string", "pattern": "^OI-[0-9]+$" }
      },
      "if": { "properties": { "kind": { "const": "computed-reference" } } },
      "then": { "required": ["generated_by", "engine"] }
    }
  }
}
